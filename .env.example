GOOGLE_SHEETS_ID=1wx3eVcxMnta_yPBrSznIVpLyBfTqU6eR6z-fBdgLau4
GOOGLE_CALENDAR_ID=primary

# Preferred (prod / Railway): paste the ENTIRE service-account JSON key as one
# line. If set, this is used for both Sheets and Calendar and enables the
# two-way Sheets sync (services/sheets_sync.py). Empty = feature stays off.
GOOGLE_SA_JSON=
# Local-dev-only fallback when GOOGLE_SA_JSON is empty: a credentials.json file on disk.
GOOGLE_CREDENTIALS_PATH=credentials.json
# How often (seconds) the two-way Sheets sync runs. Only matters if GOOGLE_SA_JSON is set.
SHEETS_SYNC_INTERVAL_SECONDS=60

ANTHROPIC_API_KEY=sk-ant-...

MINI_APP_URL=https://your-miniapp.up.railway.app
PORT=8080
